# Template only. Replace every placeholder privately before starting.
# This file works with systemd EnvironmentFile and Node --env-file.
NODE_ENV=production
PORT=5000
HOST=127.0.0.1
CLIENT_URL=https://booking.example.com
MONGO_URI=mongodb+srv://<database-user>:<url-encoded-database-password>@<cluster-host>/vehicle_service_booking
JWT_SECRET=<private-random-value-at-least-32-characters>
JWT_EXPIRES_IN=8h
GMAIL_USER=<sender-address@gmail.com>
GMAIL_APP_PASSWORD=<16-character-google-app-password>
TRUSTED_PROXY_IPS=loopback
WORKSHOP_NAME="Vehicle Service Booking"
WORKSHOP_EMAIL=
WORKSHOP_PHONE=
WORKSHOP_ADDRESS=
